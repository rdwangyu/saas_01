.case-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx 24rpx 0;
}

.case-card {
  width: 342rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.05);
}
.case-card-hover {
  opacity: 0.85;
}

.case-cover {
  width: 342rpx;
  height: 256rpx;
  display: block;
  background: #eef1f5;
}
.case-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b6bcc6;
  font-size: 24rpx;
}

.case-body {
  padding: 20rpx;
}
.case-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}
.case-chips {
  display: flex;
  flex-wrap: wrap;
}
