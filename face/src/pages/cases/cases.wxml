<view class="page">
  <empty
    wx:if="{{noCompany}}"
    text="请先在首页输入公司ID"
    icon="🏢"
    showAction="{{true}}"
    actionText="去首页"
    bind:action="goIndex"
  />

  <block wx:else>
  <view class="case-grid">
    <view
      class="case-card"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
      hover-class="case-card-hover"
    >
      <image wx:if="{{item.cover}}" class="case-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
      <view wx:else class="case-cover case-cover-empty">
        <text>暂无封面</text>
      </view>
      <view class="case-body">
        <view class="case-title">{{item.title}}</view>
        <view class="case-chips">
          <text class="chip" wx:if="{{item.style}}">{{item.style}}</text>
          <text class="chip" wx:if="{{item.area}}">{{item.area}}㎡</text>
          <text class="chip" wx:if="{{item.budgetText}}">预算{{item.budgetText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="load-more" wx:if="{{list.length}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
    <text wx:else>上拉加载更多</text>
  </view>

  <empty
    wx:if="{{!list.length && !loading}}"
    text="{{error || '暂无案例数据'}}"
    icon="📷"
    showAction="{{!!error}}"
    actionText="重新加载"
    bind:action="loadList"
  />
  </block>
</view>
