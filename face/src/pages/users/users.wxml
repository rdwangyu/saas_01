<view class="page">
  <!-- 未绑定订单 -->
  <view wx:if="{{!bound}}" class="login-gate">
    <view class="login-gate-icon">📦</view>
    <view class="login-gate-title">未绑定订单</view>
    <view class="login-gate-desc">绑定订单后即可查看客户信息</view>
    <button class="login-gate-btn" bindtap="bindOrder">绑定订单</button>
  </view>

  <block wx:elif="{{customer}}">
    <!-- 客户信息卡片 -->
    <view class="me-card">
      <view class="me-avatar">{{customer.initial}}</view>
      <view class="me-info">
        <view class="me-name">{{customer.name}}</view>
      </view>
    </view>

    <view class="card">
      <view class="info-row">
        <view class="info-label">手机号</view>
        <view class="info-value">{{customer.phone}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">地址</view>
        <view class="info-value">{{customer.address || '未填写'}}</view>
      </view>
    </view>

    <!-- 项目合同 -->
    <view class="section-title">项目合同</view>
    <view class="card contract-card">
      <view class="contract-icon">📄</view>
      <view class="contract-text">{{customer.contract || '暂无合同'}}</view>
      <view class="contract-sub" wx:if="{{!customer.contract}}">合同信息建设中</view>
    </view>

    <!-- 操作按钮 -->
    <view class="me-btns">
      <button class="btn-action btn-action-danger" bindtap="unbindOrder">解绑订单</button>
    </view>
  </block>
</view>
