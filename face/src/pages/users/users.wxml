<view class="page">
  <!-- 未登录引导 -->
  <view wx:if="{{needLogin}}" class="login-gate">
    <view class="login-gate-icon">🔐</view>
    <view class="login-gate-title">请先登录</view>
    <view class="login-gate-desc">登录后即可查看我的信息</view>
    <button class="login-gate-btn" bindtap="goLogin">登录</button>
    <button class="login-gate-secondary" bindtap="switchCompany">切换公司</button>
  </view>

  <block wx:elif="{{me}}">
    <!-- 客户信息卡片 -->
    <view class="me-card">
      <view class="me-avatar">{{me.initial}}</view>
      <view class="me-info">
        <view class="me-name">{{me.name}}</view>
      </view>
    </view>

    <view class="card">
      <view class="info-row">
        <view class="info-label">手机号</view>
        <view class="info-value">{{me.phone}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">地址</view>
        <view class="info-value">{{me.address || '未填写'}}</view>
      </view>
    </view>

    <!-- 项目合同占位 -->
    <view class="section-title">项目合同</view>
    <view class="card contract-card">
      <view class="contract-icon">📄</view>
      <view class="contract-text">暂无合同</view>
      <view class="contract-sub">合同功能建设中，敬请期待</view>
    </view>

    <!-- 操作按钮 -->
    <view class="me-btns">
      <button class="btn-action btn-action-blue" bindtap="switchCompany">切换公司</button>
      <button class="btn-action btn-action-danger" bindtap="onLogout">退出登录</button>
    </view>
  </block>
</view>
