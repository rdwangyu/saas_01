/* 当前用户 */
.me-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #3a7bfd, #5b8def);
  border-radius: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(58, 123, 253, 0.25);
}
.me-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #3a7bfd;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.me-info {
  flex: 1;
  overflow: hidden;
}
.me-name {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.me-role {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 400;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.me-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.me-actions {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx 0;
}
.btn-mini {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background: #ffffff;
  color: #3a7bfd;
  border: 1rpx solid #c7d9ff;
  margin-left: 16rpx;
}
.btn-mini::after {
  border: none;
}
.btn-mini-danger {
  color: #f43f5e;
  border-color: #fecdd3;
}

/* 列表头部 */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 24rpx;
}
.list-title {
  margin: 32rpx 0 8rpx 24rpx;
}
.btn-add {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: #3a7bfd;
  color: #ffffff;
  margin: 0;
}
.btn-add::after {
  border: none;
}

/* 用户行 */
.user-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.05);
}
.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eff4ff;
  color: #3a7bfd;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.user-info {
  flex: 1;
  overflow: hidden;
}
.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 6rpx;
}
.user-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #3a7bfd;
  background: #eff4ff;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
  font-weight: 400;
  vertical-align: middle;
}
.user-badge-off {
  color: #9ca3af;
  background: #f3f4f6;
}
.user-sub {
  font-size: 24rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}
.status-on {
  background: #10b981;
}
.status-off {
  background: #d1d5db;
}
.btn-del {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: #fff1f2;
  color: #f43f5e;
  margin: 0;
}
.btn-del::after {
  border: none;
}
