/* 统一使用全局蓝色主题（见 app.wxss） */

/* 客户信息卡片 */
.me-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--gradient-start, #3a7bfd), var(--gradient-end, #5b8def));
  border-radius: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 24rpx var(--primary-shadow, rgba(58, 123, 253, 0.3));
}
.me-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  color: var(--primary, #3a7bfd);
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.me-info {
  flex: 1;
  overflow: hidden;
}
.me-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

/* 项目合同占位 */
.contract-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 28rpx;
  text-align: center;
}
.contract-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}
.contract-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #6b7280;
}
.contract-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 操作按钮 */
.me-btns {
  padding: 16rpx 24rpx 48rpx;
}
.btn-action {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  padding: 0;
}
.btn-action::after {
  border: none;
}
.btn-action-blue {
  background: #ffffff;
  color: var(--primary, #3a7bfd);
  border: 2rpx solid var(--primary-border, #c7d9ff);
}
.btn-action-danger {
  background: #fff1f2;
  color: #f43f5e;
  border: 2rpx solid #fecdd3;
}
