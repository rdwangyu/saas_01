<view class="hero-page">
  <view class="hero-brand">
    <view class="hero-logo-wrap">
      <image class="hero-logo" src="/images/logo.png" mode="aspectFit" />
    </view>
    <view class="hero-title">云序效果图</view>
    <view class="hero-sub">输入公司ID · 开启专属展示</view>
  </view>

  <view class="hero-card">
    <view class="hero-field">
      <view class="hero-field-label">公司ID</view>
      <input
        class="hero-input"
        type="number"
        placeholder="请输入公司ID"
        placeholder-class="hero-placeholder"
        value="{{companyId}}"
        bindinput="onInput"
        confirm-type="go"
        bindconfirm="onEnter"
      />
    </view>
    <button
      class="hero-btn btn-block"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="onEnter"
    >进入公司</button>
  </view>

  <view class="hero-foot">登录后可查看我的项目进度</view>
</view>
