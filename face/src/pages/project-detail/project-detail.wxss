.head-card {
  background: linear-gradient(135deg, #3a7bfd, #5b8def);
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(58, 123, 253, 0.25);
}
.head-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  word-break: break-all;
}
.head-stage {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}
.head-stage-strong {
  color: #ffffff;
  font-weight: 600;
}

/* 时间线 */
.timeline {
  padding: 0 24rpx;
}
.tl-item {
  display: flex;
}
.tl-left {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}
.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #3a7bfd;
  border: 6rpx solid #dbe7ff;
  box-sizing: content-box;
  flex-shrink: 0;
}
.tl-line {
  flex: 1;
  width: 4rpx;
  background: #dbe7ff;
  margin-top: 8rpx;
}
.tl-content {
  flex: 1;
  margin: 20rpx 0 0 16rpx;
  padding: 24rpx;
}
.tl-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}
.tl-desc {
  font-size: 26rpx;
  color: #374151;
  white-space: pre-wrap;
  word-break: break-all;
  margin-bottom: 16rpx;
}
.tl-imgs {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.tl-img {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin: 0 12rpx 12rpx 0;
  background: #eef1f5;
}
.tl-time {
  font-size: 22rpx;
  color: #9ca3af;
}
