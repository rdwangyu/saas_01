<view class="page">
  <!-- 未绑定订单 -->
  <view wx:if="{{!bound && !loading}}" class="login-gate">
    <view class="login-gate-icon">📦</view>
    <view class="login-gate-title">未绑定订单</view>
    <view class="login-gate-desc">绑定订单后即可查看项目进度</view>
    <button class="login-gate-btn" bindtap="bindOrder">绑定订单</button>
  </view>

  <view wx:elif="{{loading}}" class="loading">加载中...</view>

  <!-- 已绑定：展示项目 -->
  <block wx:elif="{{project}}">
    <view class="project-list">
      <view class="project-card" bindtap="goDetail" hover-class="project-card-hover">
        <view class="project-head">
          <view class="project-name">{{project.project_name}}</view>
          <view class="stage-badge {{project.current_stage_name === '未开始' ? 'stage-badge-muted' : ''}}">
            {{project.current_stage_name || '未开始'}}
          </view>
        </view>
        <view class="project-meta project-address">订单编号：{{project.project_no}}</view>
        <view class="project-meta project-address">地址：{{project.address}}</view>
        <view class="project-foot">
          <text class="project-date">{{project.createdText}}</text>
          <text class="project-detail-link">查看详情 ›</text>
        </view>
      </view>
    </view>

    <empty
      wx:if="{{error}}"
      text="{{error}}"
      icon="⚠️"
      showAction="{{true}}"
      actionText="重新加载"
      bind:action="loadProject"
    />
  </block>
</view>
