<view class="page">
  <view class="project-list">
    <view
      class="project-card"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
      hover-class="project-card-hover"
    >
      <view class="project-head">
        <view class="project-name">{{item.project_name}}</view>
        <view class="stage-badge {{item.current_stage_name === '未开始' ? 'stage-badge-muted' : ''}}">
          {{item.current_stage_name || '未开始'}}
        </view>
      </view>
      <view class="project-meta">客户：{{item.customer_name}}</view>
      <view class="project-meta project-address">地址：{{item.address}}</view>
      <view class="project-foot">
        <text class="project-company">{{item.company_name}}</text>
        <text class="project-date">{{item.createdText}}</text>
      </view>
    </view>
  </view>

  <view class="load-more" wx:if="{{list.length}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
    <text wx:else>上拉加载更多</text>
  </view>

  <empty
    wx:if="{{!list.length && !loading}}"
    text="{{error || '暂无项目进度数据'}}"
    icon="🗓"
    showAction="{{!!error}}"
    actionText="重新加载"
    bind:action="loadList"
  />
</view>
