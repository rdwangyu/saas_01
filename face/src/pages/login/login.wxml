<view class="hero-page">
  <view class="hero-brand">
    <view class="hero-logo-wrap">
      <image class="hero-logo" src="/images/logo.png" mode="aspectFit" />
    </view>
    <view class="hero-title">云序效果图</view>
    <view class="hero-sub">客户登录</view>
  </view>

  <view class="hero-card">
    <view class="hero-field">
      <view class="hero-field-label">手机号</view>
      <input
        class="hero-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        placeholder-class="hero-placeholder"
        value="{{phone}}"
        data-field="phone"
        bindinput="onInput"
      />
    </view>
    <view class="hero-field">
      <view class="hero-field-label">验证码</view>
      <view class="hero-code-row">
        <input
          class="hero-input hero-code-input"
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          placeholder-class="hero-placeholder"
          value="{{code}}"
          data-field="code"
          bindinput="onInput"
          confirm-type="done"
          bindconfirm="onLogin"
        />
        <button
          class="hero-code-btn"
          loading="{{sending}}"
          disabled="{{sending || countdown > 0}}"
          bindtap="onSendCode"
        >
          {{countdown > 0 ? countdown + 's后重发' : '获取验证码'}}
        </button>
      </view>
    </view>
    <button
      class="hero-btn btn-block"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="onLogin"
    >登录</button>
  </view>

  <view class="hero-foot">验证码由公司短信服务发送</view>
</view>
