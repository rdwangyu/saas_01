<view class="page">
  <!-- 未进入公司 -->
  <empty
    wx:if="{{noCompany}}"
    text="请先在首页输入公司ID"
    icon="🏢"
    showAction="{{true}}"
    actionText="去首页"
    bind:action="goIndex"
  />

  <!-- 加载失败 -->
  <empty
    wx:elif="{{error && !company}}"
    text="{{error}}"
    icon="⚠️"
    showAction="{{true}}"
    actionText="重新加载"
    bind:action="loadCompany"
  />

  <!-- 加载中 -->
  <view wx:elif="{{loading && !company}}" class="page-loading">
    <text>加载中...</text>
  </view>

  <!-- 暂无公司 -->
  <empty wx:elif="{{!company}}" text="暂无公司信息，请先在后台添加" icon="🏢" />

  <block wx:else>
    <!-- 公司主图（占位：先用渐变横幅，后续可替换为公司主图字段） -->
    <view class="hero">
      <view class="hero-inner">
        <view class="hero-circle hero-circle-1"></view>
        <view class="hero-circle hero-circle-2"></view>
        <view class="hero-slogan">匠心品质 · 安心服务</view>
      </view>
    </view>

    <!-- logo + 名字（并排占一行） -->
    <view class="brand-row">
      <image wx:if="{{company.logo}}" class="brand-logo" src="{{company.logo}}" mode="aspectFill" />
      <view wx:else class="brand-logo brand-logo-text">{{company.logoText}}</view>
      <view class="brand-name-col">
        <view class="brand-name">{{company.name}}</view>
        <view class="hero-status {{company.active ? 'hero-status-on' : ''}}">
          {{company.active ? '营业中' : '已停用'}}
        </view>
      </view>
    </view>

    <!-- 公司简介 -->
    <view class="section-title">公司简介</view>
    <view class="card desc-card">
      <text class="desc-text" wx:if="{{company.description}}" user-select>{{company.description}}</text>
      <text class="desc-empty" wx:else>暂无简介内容</text>
    </view>

    <!-- 地址与电话 -->
    <view class="card">
      <view class="info-row" wx:if="{{company.phone}}" bindtap="callPhone" data-phone="{{company.phone}}">
        <view class="info-label">联系电话</view>
        <view class="info-value link">📞 {{company.phone}}</view>
      </view>
      <view class="info-row" wx:if="{{company.address}}">
        <view class="info-label">公司地址</view>
        <view class="info-value">{{company.address}}</view>
      </view>
      <view class="info-row" wx:if="{{company.establishedText}}">
        <view class="info-label">成立日期</view>
        <view class="info-value">{{company.establishedText}}</view>
      </view>
    </view>
  </block>
</view>
