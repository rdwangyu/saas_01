.page-loading {
  padding: 200rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

/* 头部 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
}
.hero-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: #e5edff;
  box-shadow: 0 8rpx 24rpx rgba(58, 123, 253, 0.18);
  margin-bottom: 24rpx;
}
.hero-logo-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3a7bfd;
  font-size: 72rpx;
  font-weight: 700;
}
.hero-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2937;
}
.hero-status {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
  background: #f3f4f6;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
}
.hero-status-on {
  color: #10b981;
  background: #ecfdf5;
}

/* 简介 */
.desc-card {
  padding: 32rpx;
}
