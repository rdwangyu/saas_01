.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 160rpx;
}
.empty-icon {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}
.empty-text {
  color: #9ca3af;
  font-size: 26rpx;
}
.empty-action {
  margin-top: 24rpx;
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  border: 1rpx solid #3a7bfd;
  color: #3a7bfd;
  font-size: 26rpx;
}
